<Window x:Class="LibraryTrackerApp.Views.MembersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Members Management" Height="450" Width="600">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Name"/>
            <TextBox x:Name="NameTextBox"/>
            <TextBlock Text="Email"/>
            <TextBox x:Name="EmailTextBox"/>
            <Button Content="Add Member" Width="120" Margin="0,10,0,0" Click="AddMember_Click"/>
        </StackPanel>

        <DataGrid x:Name="MembersGrid" Margin="0,150,0,0" AutoGenerateColumns="True"
                  SelectionMode="Single" IsReadOnly="True"/>
    </Grid>
</Window>
