<Window x:Class="LibraryTrackerApp.Views.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LibraryTrackerApp.ViewModels"
        Title="Library Dashboard" Height="600" Width="1000">

    <Window.DataContext>
        <vm:DashboardViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Row: Buttons + Stats -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left buttons -->
            <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="0,0,20,0">
                <Button Content="Add Book" Width="100" Margin="0,0,0,10" Command="{Binding AddBookCommand}"/>
                <Button Content="Add Member" Width="100" Margin="0,0,0,10" Command="{Binding AddMemberCommand}"/>
                <Button Content="Settings" Width="98" Command="{Binding SettingsCommand}" Click="Button_Click"/>
            </StackPanel>

            <!-- Stats -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Total Books" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalBooks}" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Total Members" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalMembers}" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Borrowed Books" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BorrowedBooks}" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Overdue Books" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding OverdueBooks}" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Right buttons -->
            <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right" Margin="20,0,0,0">
                <Button Content="Borrow / Return" Width="120" Margin="0,0,0,10" Command="{Binding BorrowReturnCommand}"/>
                <Button Content="Export Data" Width="120" Margin="0,0,0,10" Command="{Binding ExportCommand}"/>
                <Button Content="Import Data" Width="120" Margin="0,0,0,10" Command="{Binding ImportCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Bottom Row: Borrowed List DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding BorrowedList}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Book" Binding="{Binding BookTitle}" Width="*"/>
                <DataGridTextColumn Header="Member" Binding="{Binding MemberName}" Width="*"/>
                <DataGridTextColumn Header="Borrow Date" Binding="{Binding BorrowDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
