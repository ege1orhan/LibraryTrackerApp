<Window x:Class="LibraryTrackerApp.Views.BorrowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Borrow / Return" Height="500" Width="700">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Select Member"/>
            <ComboBox x:Name="MemberComboBox" DisplayMemberPath="Name" Margin="0,0,0,10"/>

            <TextBlock Text="Select Book"/>
            <ComboBox x:Name="BookComboBox" DisplayMemberPath="Title" Margin="0,0,0,10"/>

            <TextBlock Text="Due Date"/>
            <DatePicker x:Name="DueDatePicker" SelectedDate="{x:Static sys:DateTime.Now}" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Borrow Book" Width="120" Click="BorrowBook_Click" Margin="0,0,10,0"/>
                <Button Content="Return Selected Book" Width="160" Click="ReturnBook_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="BorrowedGrid" Margin="0,180,0,0" AutoGenerateColumns="False"
                  SelectionMode="Single" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Book" Binding="{Binding BookTitle}" Width="*"/>
                <DataGridTextColumn Header="Member" Binding="{Binding MemberName}" Width="*"/>
                <DataGridTextColumn Header="Borrow Date" Binding="{Binding BorrowDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
